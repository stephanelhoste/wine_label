# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Open your downloaded service account JSON and copy these three fields:

# "client_email" field
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# "private_key_id" field
GOOGLE_PRIVATE_KEY_ID=abc123...

# "private_key" field — copy the whole value including -----BEGIN/END-----
# Replace every real newline inside the key with the two characters \n
GOOGLE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=1eFUizL0eWRQsvmarTa5yszKQTiE0pbnEmVffGncJjEk
